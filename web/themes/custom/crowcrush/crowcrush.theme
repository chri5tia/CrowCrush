<?php

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_preprocess_node__article().
 */
function crowcrush_preprocess_node__article(array &$variables): void {
  $date = $variables['node']->getCreatedTime();

  $variables['date'] = \Drupal::service('date.formatter')
    ->format($date, 'custom_short_date');
}

/**
 * Implements hook_preprocess_comment().
 */
function crowcrush_preprocess_comment(array &$variables): void {
  $variables['posted_ago'] = \Drupal::service('date.formatter')
    ->formatTimeDiffSince(
      $variables['comment']->getCreatedTime(),
      ['granularity' => 1],
    );
}